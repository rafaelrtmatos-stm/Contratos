VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Necessárias no ambiente da Vercel (não no front-end) para o login local
# (/api/auth/*) funcionar com a tabela app_users do Supabase:
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Opcionais: admin de emergência. Se definidas na Vercel, permitem login
# mesmo que o Supabase esteja fora do ar ou mal configurado - mesmo
# caminho usado pelo app rumo-ao-milhao (ADMIN_EMAIL/ADMIN_PASSWORD).
ADMIN_EMAIL=
ADMIN_PASSWORD=